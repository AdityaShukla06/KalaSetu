# Copy to functions/.env for local emulator runs. This file is gitignored.
# In production GEMINI_API_KEY comes from Cloud Functions secrets instead:
#   npx firebase-tools functions:secrets:set GEMINI_API_KEY

GEMINI_API_KEY=

# Optional model overrides. Leave blank to use the defaults in
# src/voice-ai/config/env.ts. See "Confirm the Gemini model IDs"
# in `remaining tasks.md` before changing these.
GEMINI_TRANSCRIBE_MODEL=
GEMINI_FLASH_MODEL=

# Optional BHASHINI translation. All three must be set or the pipeline
# falls back to Gemini for translation. See `remaining tasks.md`.
BHASHINI_ULCA_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_PIPELINE_ID=
