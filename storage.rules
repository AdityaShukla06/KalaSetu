rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product images — owner can upload, anyone can read (needed for <img src> in the app)
    match /products/{userId}/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
