# Copy to .env for local development. This file is gitignored.
# In production these are set in the Vercel dashboard (Project -> Settings ->
# Environment Variables), NOT in a committed file.

# --- Frontend ---------------------------------------------------------------
# Leave blank in production, the API is served from the same origin at /api.
# Only set this if you run the API somewhere other than the site itself.
VITE_API_BASE_URL=

# --- Supabase ---------------------------------------------------------------
# Dashboard -> Project Settings -> Data API / API Keys
SUPABASE_URL=
# The SERVICE ROLE key, not the anon key. It bypasses row level security and
# must never be exposed to the browser or committed anywhere.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# Only needed to run scripts/verify-rls.mjs, which tests the RLS policies
# directly against Postgres rather than through the API. The server itself
# never reads these. Dashboard -> Project Settings -> API.
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# --- Sessions ---------------------------------------------------------------
# Any long random string. Generate one with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Voice AI provider -------------------------------------------------------
# groq (default) or gemini. Switching providers is an env change, not a code
# change. Only the selected provider's key is required.
VOICE_AI_PROVIDER=groq

# --- Groq, the default provider ----------------------------------------------
# https://console.groq.com -> API Keys. Free, no card.
# Whisper for speech, gpt-oss-120b for translation and description.
GROQ_API_KEY=
GROQ_STT_MODEL=
GROQ_LLM_MODEL=
# Groq caps tokens per day per model on the free tier. If the primary model
# runs out, requests fall through to this one automatically, which has its
# own allowance. Leave blank to use the default.
GROQ_LLM_FALLBACK_MODEL=
# Spare key slots, tried in order once the key above is out of quota for the
# day. IMPORTANT: Groq counts the daily quota per ORGANISATION, not per key, so
# extra keys only add headroom if each one comes from a SEPARATE Groq account.
# Several keys from one account share one allowance and buy you nothing.
# Leave blank if you only have one account.
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# Same thing as a comma separated list, if you would rather keep them on one
# line or need more than two spares. Merged with the slots above.
GROQ_FALLBACK_API_KEYS=

# --- Gemini ------------------------------------------------------------------
# Needed if you set VOICE_AI_PROVIDER=gemini, and also used as the first tier
# of the craft category suggestion below, regardless of VOICE_AI_PROVIDER.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TRANSCRIBE_MODEL=
GEMINI_FLASH_MODEL=

# --- Background removal (optional) -------------------------------------------
# Leave BACKGROUND_REMOVAL_PROVIDER=none (or every provider below unconfigured)
# to skip this feature entirely: photo uploads still work, just without
# background removal, exactly like before this was added.
#
# Comma-separated list, tried in order until one succeeds, same pattern as
# CRAFT_CLASSIFIER_PROVIDERS below:
#   remove-bg   - https://www.remove.bg, needs REMOVE_BG_API_KEY. Free tier is
#                 50 calls total on signup; check remaining credits on your
#                 remove.bg dashboard before demo day. Best cutout quality,
#                 quota-limited.
#   self-hosted - your own instance of bg-removal-service/ (see its README),
#                 needs SELF_HOSTED_BG_REMOVAL_URL. No quota, no per-call cost,
#                 but lower cutout quality on busy/patterned backgrounds; see
#                 that folder's README for the models actually measured.
# Recommended once both are set up: remove-bg,self-hosted so the free
# self-hosted tier only kicks in once remove.bg's quota is exhausted.
BACKGROUND_REMOVAL_PROVIDER=none
REMOVE_BG_API_KEY=
SELF_HOSTED_BG_REMOVAL_URL=
BACKGROUND_REMOVAL_TIMEOUT_MS=8000

# --- Craft category suggestion (optional) ------------------------------------
# Suggests a product category from the photo, tried in this order until one
# succeeds. Leave the list empty to turn the whole feature off; the category
# screen then behaves exactly as if this was never added. See SETUP.md
# section 4 for the tradeoffs of each tier.
CRAFT_CLASSIFIER_PROVIDERS=groq,gemini,render
CRAFT_CLASSIFIER_URL=https://kala-setu-image-classifier.onrender.com
CRAFT_CLASSIFIER_TIMEOUT_MS=6000
CRAFT_CLASSIFIER_RENDER_TIMEOUT_MS=20000
GEMINI_VISION_MODEL=
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_VISION_FALLBACK_MODEL=qwen/qwen3.8-27b

# --- Email OTP delivery (optional) ------------------------------------------
# Without a Resend key the app still works: the code is not emailed, and the
# demo fallback OTP below is the way in. https://resend.com/api-keys
RESEND_API_KEY=
OTP_FROM_EMAIL=

# --- Public app URL ----------------------------------------------------------
# Used server side only, to build the deep link back into the app inside the
# inquiry notification email. Set this to your deployed URL in production.
PUBLIC_APP_URL=http://localhost:5173

# --- Demo fallback OTP ------------------------------------------------------
# SECURITY: while enabled, this code signs in as ANY email address entered.
# It exists so a demo cannot be blocked by email delivery. Set
# DEMO_FALLBACK_OTP_ENABLED=false to turn it off without a code change.
DEMO_FALLBACK_OTP=5741
DEMO_FALLBACK_OTP_ENABLED=true
